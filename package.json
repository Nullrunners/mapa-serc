{
  "name": "aed-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mapa serc: one nationwide open dataset of AED defibrillators for dane.gov.pl (HackNation 2026, Misja AED)",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "pnpm --filter @aed/api dev",
    "dev:web": "pnpm --filter @aed/web dev",
    "dev:mail": "mailpit --smtp 127.0.0.1:1025 --listen 127.0.0.1:8025 --database data/mailpit.db --disable-version-check",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "contract": "pnpm --filter @aed/api contract",
    "pattern": "pnpm --filter @aed/api pattern",
    "job": "pnpm --filter @aed/api job",
    "smoke": "pnpm --filter @aed/api smoke",
    "tunnel": "pnpm --filter @aed/api tunnel"
  }
}
