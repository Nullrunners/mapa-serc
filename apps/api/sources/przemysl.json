  "extract": [{ "from": "name", "to": "id_w_zrodle", "pattern": "AED\\s*(\\d+)" }],
  "strip": [{ "column": "name", "pattern": "^Defibrylator\\s*\\(AED\\s*\\d+\\)\\s*(?:[-–]\\s*|w\\s+)?" }],
  "defaults": { "miejscowosc": "Przemyśl", "kod_terc": "1862011" }
