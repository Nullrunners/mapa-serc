  "format": "geojson",
  "fixture": "przemysl.geojson",
  "keyColumn": "id",
  "mapping": {
    "@lat": "szerokosc_geograficzna",
    "@lon": "dlugosc_geograficzna",
    "name": "nazwa",
    "city": "miejscowosc",
    "street": "nazwa_ulicy",
    "home_number": "nr_budynku",
    "postcode": "kod_pocztowy",
    "phone": "telefon_kontaktowy",
    "email": "email_kontaktowy"
