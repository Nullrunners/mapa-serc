{
  "name": "@aed/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AED Hub API: merges AED sources into one national dataset and publishes it for dane.gov.pl",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "contract": "tsx scripts/export-openapi.ts",
    "pattern": "tsx scripts/export-pattern.ts",
    "smoke": "tsx scripts/smoke.ts",
    "job": "tsx --env-file-if-exists=../../.env scripts/job.ts",
    "tunnel": "tsx --env-file-if-exists=../../.env scripts/tunnel.ts"
  },
  "dependencies": {
    "@aed/schema": "workspace:*",
    "@duckdb/node-api": "1.4.5-r.1",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.20",
    "exceljs": "^4.4.0",
    "h3-js": "^4.5.0",
    "hono": "^4.13.18",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "untun": "^0.2.2",
    "vitest": "^5.1.0"
  }
}
