# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- API (apps/api) -----------------------------------------------------------
PORT=8787
# Directory with aed.duckdb and source snapshots. Relative paths start at the repo root.
DATA_DIR=data
# Protects /admin/* and the operator actions (Radar decisions, moderation). Any long random string.
ADMIN_TOKEN=change-me
# Signs owner confirmation links. Any long random string.
LINK_SECRET=change-me-too
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
# Public URL of this API, used in the dane.gov.pl harvester feed (resource links must be absolute).
PUBLIC_API_URL=http://localhost:8787

# --- optional -----------------------------------------------------------------
# Radar: extraction from procurement notices. Without a key everything else still works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Warsaw open data API (free key from https://api.um.warszawa.pl/). Without it the Warsaw source is skipped.
WARSAW_API_KEY=

# --- web (apps/web) -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8787
