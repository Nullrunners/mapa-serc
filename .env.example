# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- API (apps/api) -----------------------------------------------------------
PORT=8787
# Directory with aed.duckdb and source snapshots. Relative paths start at the repo root.
DATA_DIR=data
# Protects /admin/* and the operator actions (Radar decisions, moderation). Any long random string.
ADMIN_TOKEN=change-me
# Signs owner confirmation links. Any long random string.
LINK_SECRET=change-me-too
# Keeper login "with mObywatel". demo (default) = a stand-in: the person picks one of a few made-up people, which
# shows the flow and protects nothing. off = keepers get in only by the link we email. The real login.gov.pl is not
# connected: a service joins it only after integration tests and with the minister's consent.
MOBYWATEL_LOGIN=demo
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
# Public URL of this API, used in the dane.gov.pl harvester feed (resource links must be absolute).
PUBLIC_API_URL=http://localhost:8787
# Proxies in front of the API that append to X-Forwarded-For (Coolify: 1). The report limits of the device passport
# take the client address from there; 0 = use the address of the connection.
TRUSTED_PROXY_HOPS=1

# --- optional -----------------------------------------------------------------
# Radar: extraction from procurement notices. Without a key everything else still works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Warsaw open data API (free key from https://api.um.warszawa.pl/). Needed only to download a fresh list with
# `pnpm job pipeline --refresh`; without it the copy of the list kept in the repository is used.
WARSAW_API_KEY=

# Device passport: messages to keepers (expiry reminders 30 and 7 days ahead, problem reports, management links).
# Without these the messages are only written to the outbox (GET /admin/outbox) and nothing is sent.
# SMTP server as a URL, e.g. smtps://user:password@smtp.example.com:465
# Locally: run `pnpm dev:mail` (Mailpit) and set smtp://localhost:1025; read the messages at http://localhost:8025
SMTP_URL=
MAIL_FROM=Mapa serc <no-reply@example.com>
# SMSAPI.pl token (https://ssl.smsapi.pl/ → API tokens). SMS_FROM is a sender name registered in SMSAPI; empty = default.
SMSAPI_TOKEN=
SMS_FROM=
# 1 = SMSAPI accepts the message but does not deliver it (test mode, no cost).
SMSAPI_TEST=

# --- web (apps/web) -----------------------------------------------------------
# The web app does not read this file. Locally it reaches the API through its own /api path (apps/web/next.config.ts);
# the deployment builds it with NEXT_PUBLIC_API_URL set to the API's public address (see compose.yaml).
# NEXT_PUBLIC_API_URL=https://api.example.org
