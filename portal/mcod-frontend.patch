+import { NgForOf, NgIf } from '@angular/common';
+import { Component, OnInit } from '@angular/core';
+import { ActivatedRoute, RouterLink, RouterLinkActive, RouterOutlet } from '@angular/router';
+import { TranslatePipe, TranslateService } from '@ngx-translate/core';
+
+import { IDatasetFile } from '@app/services/models/dataset-resource';
+import { SeoService } from '@app/services/seo.service';
+import { DownloadLinkComponent } from '@app/shared/download-link/download-link.component';
+import { LinkHelper } from '@app/shared/helpers';
+import { InfoTooltipDirective } from '@app/shared/info-tooltip/info-tooltip.directive';
+import { ResourceFiltersComponent } from '@app/shared/resource-filters/resource-filters.component';
+
+/**
+ * AED list: one table with all AED defibrillators published in the portal by many institutions.
+ * Works like the DGA protected data list page, but takes no content from CMS.
+ */
+@Component({
+  selector: 'app-aed-list',
+  templateUrl: './aed-list.component.html',
+  standalone: true,
+  imports: [
+    TranslatePipe,
+    NgIf,
+    NgForOf,
+    DownloadLinkComponent,
+    ResourceFiltersComponent,
+    InfoTooltipDirective,
+    RouterLink,
+    RouterLinkActive,
+    RouterOutlet,
+  ],
+})
+export class AedListComponent implements OnInit {
+  /**
+   * False until the portal builds the list for the first time
+   */
+  isReady = false;
+
+  pageTitle: string;
+  viewsCount: string;
+  downloadsCount: string;
+  resourceId: string;
+  resourceUrl: string;
+  /**
+   * How many rows the last build of the list holds and from how many institutions' resources
+   */
+  rowsCount: number | null = null;
+  sourcesCount: number | null = null;
+
+  dataset: any;
+  resource: any;
+  downloadFilesList: IDatasetFile[] = [];
+
+  constructor(
+    private route: ActivatedRoute,
+    private translate: TranslateService,
+    private seoService: SeoService,
+  ) {}
+
+  ngOnInit(): void {
+    const post = this.route.snapshot.data['post'];
+
+    if (!post?.resource) {
+      this.seoService.setPageTitleByTranslationKey(['AedList.Self']);
+      return;
+    }
+
+    const resData = post.resData;
+    this.resource = post.resource;
+    this.pageTitle = this.resource.attributes.title;
+    this.downloadFilesList = this.resource.attributes?.files || [];
+    this.dataset = post.stats?.data;
+    this.viewsCount = this.dataset?.attributes.views_count;
+    this.downloadsCount = this.dataset?.attributes.downloads_count;
+    this.resourceId = resData.resource_id;
+    this.rowsCount = resData.rows_count ?? null;
+    this.sourcesCount = resData.sources_count ?? null;
+    this.resourceUrl =
+      '/' +
+      this.translate.currentLang +
+      '/dataset/' +
+      resData.dataset_id +
+      ',' +
+      resData.dataset_slug +
+      '/resource/' +
+      resData.resource_id +
+      ',' +
+      resData.resource_slug;
+    this.isReady = true;
+    this.seoService.setPageTitle(this.pageTitle);
+  }
+
+  downloadResource(title: string, url: string) {
+    LinkHelper.downloadResource({ title, url });
+  }
+}
