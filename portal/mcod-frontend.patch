diff --git a/src/app/shared/breadcrumbs/resolvers/breadcrumbs-aed-list-table-data.resolver.ts b/src/app/shared/breadcrumbs/resolvers/breadcrumbs-aed-list-table-data.resolver.ts
new file mode 100644
index 0000000..729bf09
--- /dev/null
+++ b/src/app/shared/breadcrumbs/resolvers/breadcrumbs-aed-list-table-data.resolver.ts
@@ -0,0 +1,38 @@
+import { inject } from '@angular/core';
+import { combineLatest, Observable, of } from 'rxjs';
+import { catchError, map, switchMap } from 'rxjs/operators';
+
+import { AggregatedListService } from '@app/services/aggregated-list.service';
+import { DatasetService } from '@app/services/dataset.service';
+
+export const AED_LIST_SLUG = 'aed';
+
+export const breadcrumbsAedListTableDataResolver = () => {
+  const aggregatedListService = inject(AggregatedListService);
+  const datasetService = inject(DatasetService);
+
+  const getMoreData = (data): Observable<any> => {
+    return combineLatest([
+      of(data),
+      datasetService.getResourceById(data.resource_id),
+      datasetService.getDatasetsStats(data.dataset_id, data.dataset_slug),
+    ]).pipe(
+      map(([resData, resource, stats]) => {
+        return {
+          resData,
+          resource,
+          stats,
+        };
+      }),
+    );
+  };
+
+  return aggregatedListService.getAggregatedList(AED_LIST_SLUG).pipe(
+    switchMap((responseData) => getMoreData(responseData)),
+    catchError(() => {
+      // the list has not been built yet (or API is down): the page shows a plain message instead of the table
+      console.warn("Couldn't load AED list data");
+      return of(null);
+    }),
+  );
+};
