@@ -0,0 +1,56 @@
+import { DOCUMENT } from '@angular/common';
+import { HttpClient } from '@angular/common/http';
+import { Inject, Injectable, PLATFORM_ID } from '@angular/core';
+import { Router } from '@angular/router';
+import { TranslateService } from '@ngx-translate/core';
+import { CookieService } from 'ngx-cookie-service';
+import { LocalStorageService } from 'ngx-localstorage';
+
+import { ApiConfig } from '@app/services/api';
+import { LoginService } from '@app/services/login-service';
+import { NotificationsService } from '@app/services/notifications.service';
+import { RestService } from '@app/services/rest.service';
+
+/**
+ * Aggregated lists ("wykazy zbiorcze"): one summary resource built by the portal
+ * from resources published by many institutions, e.g. the AED list.
+ */
+@Injectable({
+  providedIn: 'root',
+})
+export class AggregatedListService extends RestService {
+  readonly ApiConfig = ApiConfig;
+
+  constructor(
+    protected http: HttpClient,
+    public translate: TranslateService,
+    public router: Router,
+    public notificationService: NotificationsService,
+    public storageService: LocalStorageService,
+    public cookieService: CookieService,
+    public loginService: LoginService,
+    @Inject(DOCUMENT) public document: any,
+    @Inject(PLATFORM_ID) public platformId: string,
+  ) {
+    super(
+      http,
+      translate,
+      router,
+      notificationService,
+      storageService,
+      cookieService,
+      loginService,
+      document,
+      platformId,
+    );
+  }
+
+  /**
+   * Gets ids and slugs of the dataset and the resource that hold the aggregated list.
+   * API answers 404 until the list is built for the first time, so no redirect to the 404 page here.
+   * @param {string} slug list slug, e.g. 'aed'
+   */
+  getAggregatedList(slug: string) {
+    return this.get(this.ApiConfig.aggregated_lists + '/' + slug, undefined, true);
+  }
+}
