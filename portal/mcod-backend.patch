diff --git a/mcod/resources/tasks/aggregated_lists.py b/mcod/resources/tasks/aggregated_lists.py
new file mode 100644
index 0000000..d809058
--- /dev/null
+++ b/mcod/resources/tasks/aggregated_lists.py
@@ -0,0 +1,101 @@
+import logging
+from typing import Optional
+
+from django.apps import apps
+from django.conf import settings
+
+from mcod.core.tasks import extended_shared_task
+from mcod.resources.aggregated_lists import service
+from mcod.resources.aggregated_lists.definitions import REGISTRY, get_definition
+from mcod.resources.dga_utils import (
+    FailedValidationException,
+    PendingValidationException,
+    check_all_resource_validations_status,
+)
+
+logger = logging.getLogger("mcod")
+
+
+@extended_shared_task(
+    name="mcod.resources.tasks.build_all_aggregated_lists_task",
+)
+def build_all_aggregated_lists_task() -> None:
+    """Nightly entry point (celery beat): builds every list in the registry, each in its own task."""
+    for slug in REGISTRY:
+        build_aggregated_list_task.apply_async(args=(slug,))
+
+
+@extended_shared_task(
+    name="mcod.resources.tasks.build_aggregated_list_task",
+)
+def build_aggregated_list_task(slug: str) -> dict:
+    """
+    Builds one aggregated list ("wykaz zbiorczy") and puts it into the portal:
+
+    1. Reads the published resources of datasets tagged with the list's tag and merges the rows that
+       follow the list's standard columns into one CSV, each row marked with its provider.
+    2. Creates the summary dataset and resource on the first run; later replaces the resource's file in
+       place, so its address stays the same.
+    3. Hands over to `check_aggregated_list_task`, which waits for the portal's validation of the new file.
+    """
+    definition = get_definition(slug)
+    logger.info("Building aggregated list %s.", slug)
+    result = service.build_list(definition)
+    publication = service.publish(definition, result)
+    # publish() has committed its transaction by now, so the check sees the new file.
+    check_aggregated_list_task.apply_async(
+        args=(slug, publication.resource_pk),
+        kwargs={
+            "created_resource": publication.created_resource,
+            "created_dataset_pk": publication.created_dataset_pk,
+            "previous_file": publication.previous_file,
+        },
+        countdown=settings.AGGREGATED_LISTS_VALIDATION_RETRY_COUNTDOWN,
+    )
+    return result.totals
+
+
+@extended_shared_task(
+    max_retries=10,
+    atomic=False,
+    retry_countdown=30,
+    retry_on_errors=(PendingValidationException,),
+    bind=True,
+    name="mcod.resources.tasks.check_aggregated_list_task",
+)
+def check_aggregated_list_task(
+    self,
+    slug: str,
+    resource_pk: int,
+    created_resource: bool = False,
+    created_dataset_pk: Optional[int] = None,
+    previous_file: Optional[str] = None,
+) -> None:
+    """
+    Waits (by retrying) until the portal has validated the summary file, like the DGA summary task.
+    When validation fails, or is still pending after the last retry, the publication is rolled back:
+    the previous file comes back, or the resource and dataset created by a first run are removed.
+    """
+    definition = get_definition(slug)
+    publication = service.Publication(
+        resource_pk=resource_pk,
+        created_resource=created_resource,
+        created_dataset_pk=created_dataset_pk,
+        previous_file=previous_file,
+    )
+    Resource = apps.get_model("resources", "Resource")
+    resource = Resource.raw.get(pk=resource_pk)
+
+    try:
+        check_all_resource_validations_status(resource)
+    except PendingValidationException:
+        if self.request.retries >= self.max_retries:
+            logger.error("Aggregated list %s: validation still pending after the last retry.", slug)
+            service.roll_back(definition, publication)
+        raise
+    except FailedValidationException:
+        logger.error("Aggregated list %s: summary file failed validation.", slug)
+        service.roll_back(definition, publication)
+        raise
+
+    service.mark_published(definition, resource)
