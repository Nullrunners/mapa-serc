+"""
+Portal side of the aggregated lists ("wykazy zbiorcze"): finding the providers' resources, building the
+summary table and publishing it as a resource of the summary dataset.
+
+Mirrors the DGA summary (mcod/resources/dga_utils.py) with two differences:
+
+- the summary resource keeps its id and address: each night its main file is replaced in place (like a
+  file change in the admin panel), so links to it never break; the DGA summary creates a new resource
+  and deletes the old one instead,
+- the list's definition (columns, tag, titles, owner) comes from the registry in `definitions.py`, so the
+  same code serves every list.
+
+Flow (see mcod/resources/tasks/aggregated_lists.py):
+1. `build_list`: published resources of published datasets tagged with the list's tag → one CSV.
+2. `publish`: create the summary dataset and resource on the first run, replace the file afterwards.
+3. `check_aggregated_list_task` waits for the portal's validation of the new file; on failure
+   `roll_back` restores the previous file (or deletes what the first run created).
+"""
+
+import datetime
+import logging
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Dict, List, Optional, Tuple
+
+import pandas as pd
+import requests
+import sentry_sdk
+from celery import states
+from django.apps import apps
+from django.conf import settings
+from django.core.exceptions import ObjectDoesNotExist
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.db import transaction
+from django.db.models import QuerySet
+from django.utils import timezone, translation
+
+from mcod.resources.aggregated_lists.core import (
+    SUPPORTED_EXTENSIONS,
+    Provider,
+    SourceReadError,
+    SourceReport,
+    merge_tables,
+    normalise_header,
+    portal_table_schema,
+    read_table,
+    summarise,
+    to_csv_bytes,
+)
+from mcod.resources.aggregated_lists.definitions import AggregatedListDefinition
+
+if TYPE_CHECKING:
+    from mcod.datasets.models import Dataset
+    from mcod.resources.models import AggregatedListInfo, Resource
+
+logger = logging.getLogger("mcod")
+
+CSV_MIMETYPE = "text/csv"
+REMOTE_TIMEOUT = (3.0, 30.0)
+
+
+@dataclass
+class BuildResult:
+    content: bytes
+    reports: List[SourceReport]
+    totals: Dict[str, Any]
+    built_at: datetime.datetime = field(default_factory=timezone.now)
+
+    def as_report(self) -> Dict[str, Any]:
+        return {**self.totals, "sources_report": [r.as_dict() for r in self.reports]}
+
+
+@dataclass
+class Publication:
+    resource_pk: int
+    # Set only when this run created them, so a failed first run can remove them again.
+    created_resource: bool = False
+    created_dataset_pk: Optional[int] = None
+    # Storage name of the file this run replaced, to restore it when the new one fails validation.
+    previous_file: Optional[str] = None
+
+
+def owner_organization_pk(definition: AggregatedListDefinition) -> int:
+    return int(definition.owner_organization_pk or settings.AGGREGATED_LISTS_OWNER_ORGANIZATION_PK)
+
+
+def get_info(definition: AggregatedListDefinition, create: bool = False) -> Optional["AggregatedListInfo"]:
+    AggregatedListInfo = apps.get_model("resources", "AggregatedListInfo")
+    if create:
+        info, _ = AggregatedListInfo.objects.get_or_create(slug=definition.slug)
+        return info
+    return AggregatedListInfo.objects.filter(slug=definition.slug).first()
+
+
+def get_summary_resource(definition: AggregatedListDefinition) -> Optional["Resource"]:
+    info = get_info(definition)
+    return info.summary_resource if info else None
+
+
+def get_source_resources(definition: AggregatedListDefinition) -> QuerySet:
+    """
+    Published CSV/XLSX/XLS resources of published datasets carrying the list's tag, whose file, link and
+    data validation succeeded (the same prefilter as the DGA summary). Ordered by institution.
+    """
+    Resource = apps.get_model("resources", "Resource")
+    Dataset = apps.get_model("datasets", "Dataset")
+
+    member_datasets = Dataset.objects.filter(status="published", tags__name__iexact=definition.tag).values("pk")
+    queryset = Resource.objects.filter(
+        dataset__in=member_datasets,
+        status="published",
+        format__in=SUPPORTED_EXTENSIONS,
+        data_tasks_last_status=states.SUCCESS,
+        file_tasks_last_status=states.SUCCESS,
+        link_tasks_last_status=states.SUCCESS,
+    )
+    info = get_info(definition)
+    if info and info.resource_id:
+        queryset = queryset.exclude(pk=info.resource_id)
+    if info and info.dataset_id:
+        queryset = queryset.exclude(dataset_id=info.dataset_id)
+    return queryset.select_related("dataset__organization").order_by("dataset__organization__title", "pk")
+
+
+def _read_from_tabular_data(resource: "Resource") -> pd.DataFrame:
+    tabular_data = resource.tabular_data
+    if tabular_data is None:
+        raise SourceReadError(f"Zasób {resource.pk} nie ma pliku, adresu ani danych tabelarycznych.")
+    rows = tabular_data.table.read(keyed=True)
+    df = pd.DataFrame(rows).astype(str)
+    df.columns = [normalise_header(c) for c in df.columns]
+    return df
+
+
+def read_source_table(resource: "Resource") -> pd.DataFrame:
+    """
+    The provider's table as text. Order: the stored file (exact values, no type guessing), then the
+    resource's address (remote and CKAN-harvested resources), then the portal's parsed tabular data.
+    """
+    main_file = resource.main_file
+    if main_file and not resource.main_file_compressed_format:
+        try:
+            with main_file.open("rb") as handle:
+                return read_table(handle.read(), resource.format)
+        except (OSError, ValueError) as exc:
+            logger.warning("Aggregated list: cannot open file of resource %s: %s", resource.pk, exc)
+
+    if resource.link and not resource.is_link_internal:
+        try:
+            response = requests.get(resource.link, timeout=REMOTE_TIMEOUT)
+            response.raise_for_status()
+        except requests.exceptions.RequestException as exc:
+            raise SourceReadError(f"Nie udało się pobrać {resource.link}: {exc}") from exc
+        return read_table(response.content, resource.format)
+
+    try:
+        return _read_from_tabular_data(resource)
+    except SourceReadError:
+        raise
+    except Exception as exc:
+        raise SourceReadError(f"Nie udało się odczytać danych tabelarycznych zasobu {resource.pk}: {exc}") from exc
+
+
+def provider_for(resource: "Resource") -> Provider:
+    updated = resource.data_date or (resource.modified.date() if resource.modified else None)
+    with translation.override(settings.LANGUAGES[0][0]):
+        url = resource.frontend_absolute_url
+    return Provider(
+        name=resource.institution.title,
+        resource_url=url,
+        updated=updated.isoformat() if updated else "",
+        resource_id=resource.pk,
+    )
+
+
+def build_list(definition: AggregatedListDefinition) -> BuildResult:
+    parts: List[Tuple[Provider, pd.DataFrame]] = []
+    unreadable: List[SourceReport] = []
+
+    for resource in get_source_resources(definition):
+        provider = provider_for(resource)
+        try:
+            parts.append((provider, read_source_table(resource)))
+        except SourceReadError as exc:
+            sentry_sdk.api.capture_exception(exc)
+            logger.error("Aggregated list %s: skipping resource %s: %s", definition.slug, resource.pk, exc)
+            unreadable.append(SourceReport(provider=provider.name, resource_id=resource.pk, error=str(exc)))
+
+    merged, reports = merge_tables(parts, definition.schema)
+    reports = reports + unreadable
+    for report in reports:
+        if report.error:
+            logger.warning("Aggregated list %s: resource %s left out: %s", definition.slug, report.resource_id, report.error)
+        elif report.skipped:
+            logger.info("Aggregated list %s: resource %s rows skipped: %s", definition.slug, report.resource_id, report.skipped)
+
+    totals = summarise(reports)
+    logger.info("Aggregated list %s built: %s", definition.slug, dict(totals))
+    return BuildResult(content=to_csv_bytes(merged), reports=reports, totals=dict(totals))
+
+
+def _summary_file(definition: AggregatedListDefinition, content: bytes) -> SimpleUploadedFile:
+    name = f"{definition.file_name_prefix} {timezone.now():%Y%m%d}.csv"
+    return SimpleUploadedFile(name=name, content=content, content_type=CSV_MIMETYPE)
+
+
+def _create_summary_dataset(definition: AggregatedListDefinition) -> "Dataset":
+    Organization = apps.get_model("organizations", "Organization")
+    Dataset = apps.get_model("datasets", "Dataset")
+    Category = apps.get_model("categories", "Category")
+    Tag = apps.get_model("tags", "Tag")
+
+    organization_pk = owner_organization_pk(definition)
+    try:
+        institution = Organization.objects.get(pk=organization_pk)
+    except Organization.DoesNotExist:
+        logger.error("Aggregated list %s: owner institution %s not found.", definition.slug, organization_pk)
+        raise ObjectDoesNotExist(f"Owner institution {organization_pk} of aggregated list {definition.slug} not found.")
+
+    dataset = Dataset.objects.create(
+        title=definition.dataset_title,
+        notes=definition.dataset_description,
+        organization=institution,
+        update_notification_recipient_email=settings.AGGREGATED_LISTS_NOTIFICATION_EMAIL,
+        has_dynamic_data=False,
+        has_high_value_data=False,
+        has_high_value_data_from_ec_list=False,
+        has_research_data=False,
+        update_frequency="daily",
+        status="published",
+    )
+
+    categories = list(Category.objects.filter(title__in=definition.category_titles))
+    missing = set(definition.category_titles) - {c.title for c in categories}
+    for title in sorted(missing):
+        logger.warning("Aggregated list %s: no category titled %s.", definition.slug, title)
+
+    language = settings.LANGUAGES[0][0]
+    tags = [Tag.objects.get_or_create(name=name, language=language)[0] for name in definition.dataset_tags]
+
+    dataset.categories.set(categories)
+    dataset.tags.set(tags)
+    dataset.save()
+    logger.info("Aggregated list %s: created summary dataset %s.", definition.slug, dataset.pk)
+    return dataset
+
+
+def publish(definition: AggregatedListDefinition, result: BuildResult) -> Publication:
+    """
+    Puts the built CSV into the portal. First run: summary dataset (if missing), resource and its file;
+    the file's post_save signal starts the usual validation. Later runs: the main file is replaced in place
+    and validation is started explicitly, because replacing a file does not trigger it.
+    """
+    Resource = apps.get_model("resources", "Resource")
+    ResourceFile = apps.get_model("resources", "ResourceFile")
+    from mcod.resources.tasks import entrypoint_process_resource_file_validation_task
+
+    info = get_info(definition, create=True)
+    resource = info.summary_resource
+    today = timezone.now().date()
+
+    with transaction.atomic():
+        if resource is None:
+            created_dataset_pk = None
+            dataset = info.summary_dataset
+            if dataset is None:
+                dataset = _create_summary_dataset(definition)
+                created_dataset_pk = dataset.pk
+
+            resource = Resource.objects.create(
+                title=definition.resource_title,
+                description=definition.resource_description,
+                dataset=dataset,
+                has_dynamic_data=False,
+                has_high_value_data=False,
+                has_high_value_data_from_ec_list=False,
+                has_research_data=False,
+                contains_protected_data=False,
+                status="published",
+                data_date=today,
+                # a new resource has no special signs yet
+                tabular_data_schema=portal_table_schema(definition.schema),
+            )
+            # post_save of a new main file of a published resource runs all validation tasks
+            ResourceFile.objects.create(resource=resource, is_main=True, file=_summary_file(definition, result.content))
+            publication = Publication(resource_pk=resource.pk, created_resource=True, created_dataset_pk=created_dataset_pk)
+            info.dataset = dataset
+            logger.info("Aggregated list %s: created summary resource %s.", definition.slug, resource.pk)
+        else:
+            current = ResourceFile.objects.filter(resource=resource, is_main=True).first()
+            previous_file = current.file.name if current and current.file else None
+            resource.data_date = today
+            resource.save()
+            resource_file, created = ResourceFile.objects.update_or_create(
+                resource=resource, is_main=True, defaults={"file": _summary_file(definition, result.content)}
+            )
+            # Statuses of the previous file must not count as the result for the new one. The schema is
+            # written again each run, so a changed standard (or special signs added in the panel) applies.
+            Resource.raw.filter(pk=resource.pk).update(
+                data_tasks_last_status=states.PENDING,
+                file_tasks_last_status=states.PENDING,
+                link_tasks_last_status=states.PENDING,
+                tabular_data_schema=portal_table_schema(definition.schema, resource.special_signs_symbols_list),
+            )
+            if not created:
+                entrypoint_process_resource_file_validation_task.apply_async_on_commit(
+                    args=(resource_file.pk,), kwargs={"update_file_archive": True}
+                )
+            publication = Publication(resource_pk=resource.pk, previous_file=previous_file)
+            logger.info("Aggregated list %s: replaced file of summary resource %s.", definition.slug, resource.pk)
+
+        info.resource = resource
+        info.built_at = result.built_at
+        info.report = result.as_report()
+        info.save()
+
+    return publication
+
+
+def mark_published(definition: AggregatedListDefinition, resource: "Resource") -> None:
+    info = get_info(definition, create=True)
+    info.resource = resource
+    info.dataset = resource.dataset
+    info.published_at = timezone.now()
+    info.save()
+    logger.info("Aggregated list %s: summary resource %s validated and published.", definition.slug, resource.pk)
+
+
+def roll_back(definition: AggregatedListDefinition, publication: Publication) -> None:
+    """Undoes a publication whose file did not pass the portal's validation."""
+    Resource = apps.get_model("resources", "Resource")
+    Dataset = apps.get_model("datasets", "Dataset")
+    ResourceFile = apps.get_model("resources", "ResourceFile")
+    from mcod.resources.tasks import entrypoint_process_resource_file_validation_task
+
+    try:
+        if publication.created_resource:
+            Resource.raw.filter(pk=publication.resource_pk).delete()
+            if publication.created_dataset_pk:
+                Dataset.raw.filter(pk=publication.created_dataset_pk).delete()
+            logger.warning("Aggregated list %s: removed summary created by the failed run.", definition.slug)
+        elif publication.previous_file:
+            files = ResourceFile.objects.filter(resource_id=publication.resource_pk, is_main=True)
+            files.update(file=publication.previous_file)
+            resource_file = files.first()
+            if resource_file:
+                entrypoint_process_resource_file_validation_task.apply_async_on_commit(
+                    args=(resource_file.pk,), kwargs={"update_file_archive": True}
+                )
+            logger.warning(
+                "Aggregated list %s: restored previous file %s of resource %s.",
+                definition.slug,
+                publication.previous_file,
+                publication.resource_pk,
+            )
+    except Exception as exc:
+        logger.error("Aggregated list %s: roll back failed: %s", definition.slug, exc)
+        sentry_sdk.api.capture_exception(exc)
