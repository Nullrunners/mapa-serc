+"""
+Tests of the aggregated lists core (reading, checking and merging provider tables).
+
+They need only pandas and openpyxl, not the portal stack, so they also run outside Docker:
+    python -m pytest -o addopts="" --noconftest mcod/resources/tests/test_aggregated_lists_core.py
+"""
+
+import io
+
+import pandas as pd
+import pytest
+
+from mcod.resources.aggregated_lists.core import (
+    PROVIDER_COLUMNS,
+    SKIP_DUPLICATE_KEY,
+    SKIP_EMPTY_REQUIRED,
+    SKIP_INVALID_VALUE,
+    MissingColumnsError,
+    Provider,
+    SourceReadError,
+    TableSchema,
+    check_columns,
+    clean_table,
+    merge_tables,
+    portal_table_schema,
+    read_table,
+    summarise,
+    to_csv_bytes,
+)
+from mcod.resources.aggregated_lists.definitions import AED, REGISTRY, AggregatedListDefinition, definitions_for_tags, get_definition
+
+SCHEMA = AED.schema
+
+ROW = {
+    "id": "3f0c2a8e-5b1d-4c7a-9e21-6d4b8f0a1c55",
+    "nazwa": "Urząd Miasta – hol główny",
+    "cecha_ulicy": "ul.",
+    "nazwa_ulicy": "Piłsudskiego",
+    "nr_budynku": "1",
+    "kod_pocztowy": "05-120",
+    "miejscowosc": "Legionowo",
+    "kod_terc": "1408011",
+    "szerokosc_geograficzna": "52.4012",
+    "dlugosc_geograficzna": "20.9265",
+    "status": "czynny",
+    "zrodlo": "Urząd Miasta Legionowo",
+    "licencja": "CC0 1.0",
+    "data_aktualizacji": "2026-11-21",
+}
+
+
+def table(*rows, **overrides):
+    return pd.DataFrame([{**ROW, **overrides, **row} for row in rows] or [{**ROW, **overrides}], dtype=str)
+
+
+def test_aed_definition_uses_the_pattern():
+    assert REGISTRY["aed"] is AED
+    assert AED.tag == "wykaz-aed"
+    assert SCHEMA.column_names[:3] == ["id", "nazwa", "cecha_ulicy"]
+    assert len(SCHEMA.column_names) == 34
+    assert set(SCHEMA.required_names) == {
+        "id",
+        "nazwa",
+        "miejscowosc",
+        "kod_terc",
+        "szerokosc_geograficzna",
+        "dlugosc_geograficzna",
+        "status",
+        "zrodlo",
+        "licencja",
+        "data_aktualizacji",
+    }
+    assert SCHEMA.primary_key == ("id",)
+    assert AED.output_columns == SCHEMA.column_names + list(PROVIDER_COLUMNS)
+
+
+def test_definition_lookup_by_slug_and_tag():
+    assert get_definition("aed") is AED
+    with pytest.raises(KeyError):
+        get_definition("nie-ma")
+    assert definitions_for_tags(["AED", "Wykaz-AED "]) == [AED]
+    assert definitions_for_tags(["defibrylator"]) == []
+
+
+def test_summary_dataset_cannot_carry_its_membership_tag():
+    with pytest.raises(ValueError):
+        AggregatedListDefinition(
+            slug="x",
+            tag="wykaz-x",
+            schema_file="aed.json",
+            dataset_title="",
+            dataset_description="",
+            resource_title="",
+            resource_description="",
+            file_name_prefix="",
+            dataset_tags=("wykaz-x",),
+        )
+
+
+def test_reads_csv_with_semicolons_cp1250_and_messy_headers():
+    content = "﻿ID ;Nazwa;Miejscowość\n1;Hol;Łódź\n".encode("utf-8")
+    df = read_table(content, "csv")
+    assert list(df.columns) == ["id", "nazwa", "miejscowość"]
+    assert df.iloc[0].tolist() == ["1", "Hol", "Łódź"]
+
+    content = "nazwa;miejscowosc\nPrzychodnia;Łódź\n".encode("cp1250")
+    df = read_table(content, "CSV")
+    assert df.iloc[0]["miejscowosc"] == "Łódź"
+
+
+def test_reads_xlsx_as_text():
+    buffer = io.BytesIO()
+    table().to_excel(buffer, index=False)
+    df = read_table(buffer.getvalue(), "xlsx")
+    assert df.iloc[0]["kod_terc"] == "1408011"
+    assert df.iloc[0]["nazwa"] == ROW["nazwa"]
+
+
+def test_rejects_unknown_format_and_broken_file():
+    with pytest.raises(SourceReadError):
+        read_table(b"{}", "json")
+    with pytest.raises(SourceReadError):
+        read_table(b"not an excel file", "xlsx")
+
+
+def test_missing_required_columns_are_named():
+    with pytest.raises(MissingColumnsError) as error:
+        check_columns(table().drop(columns=["kod_terc", "status"]), SCHEMA)
+    assert error.value.columns == ["kod_terc", "status"]
+
+
+def test_clean_table_keeps_pattern_columns_and_fills_optional_ones():
+    df = table()
+    df["kolumna_dostawcy"] = "x"
+    cleaned, skipped = clean_table(df, SCHEMA)
+    assert list(cleaned.columns) == SCHEMA.column_names
+    assert skipped == {}
+    assert cleaned.iloc[0]["nr_lokalu"] == ""
+    assert cleaned.iloc[0]["nazwa"] == ROW["nazwa"]
+
+
+def test_clean_table_skips_rows_with_empty_or_invalid_required_values():
+    df = table(
+        {},
+        {"id": "a1b2c3d4-0000-4000-8000-000000000001", "nazwa": "  "},
+        {"id": "a1b2c3d4-0000-4000-8000-000000000002", "szerokosc_geograficzna": "60.1"},
+        {"id": "a1b2c3d4-0000-4000-8000-000000000003", "status": "dziala"},
+        {"id": "nie-uuid"},
+        {"id": "a1b2c3d4-0000-4000-8000-000000000004", "data_aktualizacji": "21.11.2026"},
+    )
+    cleaned, skipped = clean_table(df, SCHEMA)
+    assert cleaned["id"].tolist() == [ROW["id"]]
+    assert skipped == {SKIP_EMPTY_REQUIRED: 1, SKIP_INVALID_VALUE: 4}
+
+
+def test_clean_table_repairs_spreadsheet_damage():
+    df = table(
+        {
+            "kod_terc": "201011",
+            "szerokosc_geograficzna": "52,4012",
+            "dlugosc_geograficzna": " 20.9265 ",
+            "data_aktualizacji": "2026-11-21 00:00:00",
+        },
+        {"id": "a1b2c3d4-0000-4000-8000-000000000005", "kod_terc": "1408011.0"},
+    )
+    cleaned, skipped = clean_table(df, SCHEMA)
+    assert skipped == {}
+    assert cleaned["kod_terc"].tolist() == ["0201011", "1408011"]
+    assert cleaned.iloc[0]["szerokosc_geograficzna"] == "52.4012"
+    assert cleaned.iloc[0]["dlugosc_geograficzna"] == "20.9265"
+    assert cleaned.iloc[0]["data_aktualizacji"] == "2026-11-21"
+
+
+def test_merge_attributes_every_row_to_its_provider_and_drops_repeated_ids():
+    legionowo = Provider(
+        name="Urząd Miasta Legionowo",
+        resource_url="https://dane.gov.pl/pl/dataset/1/resource/11",
+        updated="2026-11-21",
+        resource_id=11,
+    )
+    marki = Provider(name="Urząd Miasta Marki", resource_url="https://dane.gov.pl/pl/dataset/2/resource/22", updated="2026-11-20", resource_id=22)
+    broken = Provider(name="Gmina bez kolumn", resource_id=33)
+
+    second = "b2c3d4e5-0000-4000-8000-000000000001"
+    merged, reports = merge_tables(
+        [
+            (legionowo, table()),
+            (marki, table({}, {"id": second, "miejscowosc": "Marki", "kod_terc": "1434031"})),
+            (broken, pd.DataFrame({"nazwa": ["x"]})),
+        ],
+        SCHEMA,
+    )
+
+    assert list(merged.columns) == AED.output_columns
+    assert merged["id"].tolist() == [ROW["id"], second]
+    assert merged["dysponent_danych"].tolist() == ["Urząd Miasta Legionowo", "Urząd Miasta Marki"]
+    assert merged.iloc[1]["zasob_zrodlowy"] == "https://dane.gov.pl/pl/dataset/2/resource/22"
+    assert merged.iloc[1]["aktualizacja_zasobu_zrodlowego"] == "2026-11-20"
+
+    assert [r.rows_published for r in reports] == [1, 1, 0]
+    assert reports[1].skipped == {SKIP_DUPLICATE_KEY: 1}
+    assert reports[2].error.startswith("Brak wymaganych kolumn: id")
+
+    totals = summarise(reports)
+    assert totals["sources"] == 3
+    assert totals["sources_used"] == 2
+    assert totals["sources_rejected"] == 1
+    assert totals["rows_read"] == 4
+    assert totals["rows_published"] == 2
+    assert totals["skipped"] == {SKIP_DUPLICATE_KEY: 1}
+
+
+def test_merge_with_no_usable_sources_gives_header_only():
+    merged, reports = merge_tables([], SCHEMA)
+    assert merged.empty
+    assert list(merged.columns) == AED.output_columns
+    assert to_csv_bytes(merged).decode("utf-8") == ",".join(AED.output_columns) + "\r\n"
+
+
+def test_csv_output_is_rfc4180_and_reads_back():
+    merged, _ = merge_tables([(Provider(name='Gmina "Przykładowa", Biuro'), table(nazwa="Hol, parter"))], SCHEMA)
+    content = to_csv_bytes(merged)
+    assert not content.startswith(b"\xef\xbb\xbf")
+    assert b"\r\n" in content
+    assert '"Hol, parter"' in content.decode("utf-8")
+    back = pd.read_csv(io.BytesIO(content), dtype=str, keep_default_na=False)
+    assert back.iloc[0]["dysponent_danych"] == 'Gmina "Przykładowa", Biuro'
+    assert back.iloc[0]["kod_terc"] == "1408011"
+
+
+def test_schema_from_dict_accepts_string_primary_key():
+    schema = TableSchema.from_dict({"fields": [{"name": "a", "constraints": {"required": True}}], "primaryKey": "a"})
+    assert schema.primary_key == ("a",)
+    assert schema.required_names == ["a"]
+
+
+def test_portal_schema_types_only_checked_columns_and_sets_the_map():
+    portal = portal_table_schema(SCHEMA)
+    names = [f["name"] for f in portal["fields"]]
+    assert names == AED.output_columns
+    types = {f["name"]: f["type"] for f in portal["fields"]}
+    # checked by clean_table, so they always cast
+    assert types["szerokosc_geograficzna"] == types["dlugosc_geograficzna"] == "number"
+    assert types["data_aktualizacji"] == "date"
+    # unchecked values stay text: "50B" after "57", "41" must not break the summary's validation
+    assert types["nr_budynku"] == "string"
+    assert types["wewnatrz_budynku"] == "string"
+    assert types["termin_waznosci_baterii"] == "string"
+    assert all(types[name] == "string" for name in PROVIDER_COLUMNS)
+    assert portal["geo"] == {
+        "label": {"col_name": "nazwa", "col_index": names.index("nazwa")},
+        "b": {"col_name": "szerokosc_geograficzna", "col_index": names.index("szerokosc_geograficzna")},
+        "l": {"col_name": "dlugosc_geograficzna", "col_index": names.index("dlugosc_geograficzna")},
+    }
+    # the portal keeps a stored schema only while missingValues equals the resource's special signs
+    assert portal["missingValues"] == []
+    assert portal_table_schema(SCHEMA, ["-"])["missingValues"] == ["-"]
