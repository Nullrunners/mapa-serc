+import json
+
+from django.core.management.base import BaseCommand, CommandError
+
+from mcod.resources.aggregated_lists import service
+from mcod.resources.aggregated_lists.definitions import REGISTRY, get_definition
+
+
+class Command(BaseCommand):
+    help = (
+        "Buduje wykaz zbiorczy (np. defibrylatorów AED) z zasobów zbiorów oznaczonych tagiem wykazu. "
+        "Bez --dry-run publikuje wynik w portalu tak samo jak nocne zadanie."
+    )
+
+    def add_arguments(self, parser):
+        parser.add_argument("slugs", nargs="*", help=f"Wykazy do zbudowania (domyślnie wszystkie: {', '.join(REGISTRY)}).")
+        parser.add_argument(
+            "--dry-run",
+            action="store_true",
+            help="Tylko zbuduj wykaz i pokaż raport, niczego nie zapisuj w portalu.",
+        )
+        parser.add_argument("--output", help="Zapisz zbudowany plik CSV pod tą ścieżką (przydatne z --dry-run).")
+        parser.add_argument(
+            "--async",
+            dest="run_async",
+            action="store_true",
+            help="Zleć budowę zadaniu Celery zamiast budować w tym procesie.",
+        )
+
+    def handle(self, *args, **options):
+        slugs = options["slugs"] or list(REGISTRY)
+        try:
+            definitions = [get_definition(slug) for slug in slugs]
+        except KeyError as exc:
+            raise CommandError(str(exc))
+        if options["output"] and len(definitions) > 1:
+            raise CommandError("--output działa dla jednego wykazu naraz.")
+
+        for definition in definitions:
+            if options["run_async"]:
+                from mcod.resources.tasks import build_aggregated_list_task
+
+                build_aggregated_list_task.apply_async(args=(definition.slug,))
+                self.stdout.write(f"{definition.slug}: zlecono budowę wykazu.")
+                continue
+
+            result = service.build_list(definition)
+            if options["output"]:
+                with open(options["output"], "wb") as handle:
+                    handle.write(result.content)
+                self.stdout.write(f"{definition.slug}: zapisano {options['output']}.")
+            self.stdout.write(json.dumps(result.as_report(), ensure_ascii=False, indent=2, default=str))
+
+            if options["dry_run"]:
+                continue
+
+            publication = service.publish(definition, result)
+            from mcod.resources.tasks import check_aggregated_list_task
+
+            check_aggregated_list_task.apply_async(
+                args=(definition.slug, publication.resource_pk),
+                kwargs={
+                    "created_resource": publication.created_resource,
+                    "created_dataset_pk": publication.created_dataset_pk,
+                    "previous_file": publication.previous_file,
+                },
+                countdown=30,
+            )
+            resource = service.get_summary_resource(definition)
+            address = resource.frontend_absolute_url if resource else f"zasób {publication.resource_pk}"
+            self.stdout.write(self.style.SUCCESS(f"{definition.slug}: opublikowano {address}; trwa walidacja pliku w portalu."))
