@@ -0,0 +1,446 @@
+{
+  "$schema": "https://specs.frictionlessdata.io/schemas/table-schema.json",
+  "name": "wzorzec-danych-aed",
+  "title": "Wzorzec danych: lokalizacje defibrylatorów AED",
+  "version": "0.1.0",
+  "description": "Jednolity zakres danych o publicznie dostępnych defibrylatorach AED do udostępniania w portalu dane.gov.pl. Pola wymagane są zawsze wypełnione; pola zalecane wypełnia opiekun przy zgłoszeniu urządzenia.",
+  "fields": [
+    {
