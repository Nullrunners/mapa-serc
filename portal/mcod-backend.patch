@@ -0,0 +1,9 @@
+"""
+Aggregated lists ("wykazy zbiorcze"): one standard table built by the portal from the resources of many
+providers, each row attributed to the institution that published it. AED defibrillators are the first list.
+
+- definitions.py  registry of lists (membership tag, standard columns, summary dataset metadata)
+- core.py         reading, checking and merging tables (pandas only, no Django)
+- service.py      portal side: finding source resources and publishing the summary resource
+- schemas/        Table Schemas with each list's standard columns
+"""
diff --git a/mcod/resources/aggregated_lists/core.py b/mcod/resources/aggregated_lists/core.py
new file mode 100644
index 0000000..f23bf82
--- /dev/null
+++ b/mcod/resources/aggregated_lists/core.py
@@ -0,0 +1,378 @@
+"""
+Core of the aggregated lists ("wykazy zbiorcze"): reading a provider's table, checking it against the
+list's standard (a Frictionless Table Schema), cleaning rows and merging all providers into one table.
+
+Pure pandas and the standard library: nothing here imports Django, so it can be tested without the
+portal stack (see mcod/resources/tests/test_aggregated_lists_core.py). The Django side (querysets,
+publishing the summary resource) lives in `service.py`.
+
+Rules, in the order they are applied to each provider's table:
+
+1. Headers are compared after trimming whitespace and a BOM, lower-casing and turning spaces and
+   hyphens into underscores, so "Nazwa " and "nazwa" are the same column.
+2. All columns marked `required` in the schema must be present; otherwise the whole table is skipped
+   (as the DGA summary does with tables missing its columns).
+3. Columns outside the standard are dropped; missing optional columns are added empty.
+4. A row is skipped when a required value is empty or does not match the schema (number range,
+   allowed values, pattern). Each reason is counted per provider for the report.
+5. Rows are merged in provider order. A row whose primary key was already published by an earlier
+   provider is skipped and counted, so the summary never holds two rows with the same identifier.
+6. Every published row gets the provider columns (`PROVIDER_COLUMNS`): who publishes the source table
+   in the portal, where it is and when it was last updated. The provider stays responsible for its rows.
+"""
+
+import csv
+import datetime
+import io
+import json
+import re
+from collections import Counter, OrderedDict
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple, Union
+
+import pandas as pd
+
+SUPPORTED_EXTENSIONS: Tuple[str, ...] = ("csv", "xlsx", "xls")
+
+# Provider columns appended to every row of a summary list. Named like the pattern's own columns
+# (Polish snake_case) so the summary stays one consistent table.
+PROVIDER_NAME_COLUMN = "dysponent_danych"
+PROVIDER_RESOURCE_COLUMN = "zasob_zrodlowy"
+PROVIDER_UPDATED_COLUMN = "aktualizacja_zasobu_zrodlowego"
+PROVIDER_COLUMNS: Tuple[str, ...] = (PROVIDER_NAME_COLUMN, PROVIDER_RESOURCE_COLUMN, PROVIDER_UPDATED_COLUMN)
+
+# Reasons a row or a whole table is left out; the keys go into the build report.
+SKIP_EMPTY_REQUIRED = "brak_wymaganej_wartosci"
+SKIP_INVALID_VALUE = "nieprawidlowa_wartosc"
+SKIP_DUPLICATE_KEY = "powtorzony_identyfikator"
+
+_CSV_DELIMITERS = ",;\t|"
+_CSV_ENCODINGS = ("utf-8-sig", "cp1250", "iso-8859-2")
+_DIGITS_PATTERN = re.compile(r"^\^\\d\{(\d+)\}\$$")
+
+
+class AggregatedListError(Exception):
+    """Base class for problems with one provider's table."""
+
+
+class SourceReadError(AggregatedListError):
+    """The table cannot be read (unknown format, broken file, unknown encoding)."""
+
+
+class MissingColumnsError(AggregatedListError):
+    """The table lacks columns the list requires."""
+
+    def __init__(self, columns: Sequence[str]):
+        self.columns = list(columns)
+        super().__init__("Brak wymaganych kolumn: " + ", ".join(self.columns))
+
+
+@dataclass(frozen=True)
+class SchemaField:
+    name: str
+    type: str = "string"
+    required: bool = False
+    minimum: Optional[float] = None
+    maximum: Optional[float] = None
+    enum: Optional[Tuple[str, ...]] = None
+    pattern: Optional[str] = None
+    # Role of the column on the portal's map preview (`x-dane-gov-pl-geo` in the schema): b, l or label.
+    portal_geo: Optional[str] = None
+
+    def problem(self, value: str) -> Optional[str]:
+        """Why a non-empty value breaks the schema, or None when it is fine."""
+        if self.type in ("number", "integer"):
+            try:
+                number = float(value)
+            except ValueError:
+                return SKIP_INVALID_VALUE
+            if self.minimum is not None and number < self.minimum:
+                return SKIP_INVALID_VALUE
+            if self.maximum is not None and number > self.maximum:
+                return SKIP_INVALID_VALUE
+        if self.type == "date":
+            try:
+                datetime.date.fromisoformat(value)
+            except ValueError:
+                return SKIP_INVALID_VALUE
+        if self.enum is not None and value not in self.enum:
+            return SKIP_INVALID_VALUE
+        # Table Schema patterns match the whole value (XML Schema semantics), anchors or not.
+        if self.pattern is not None and re.fullmatch(self.pattern, value) is None:
+            return SKIP_INVALID_VALUE
+        return None
+
+
+@dataclass(frozen=True)
+class TableSchema:
+    fields: Tuple[SchemaField, ...]
+    primary_key: Tuple[str, ...] = ()
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any]) -> "TableSchema":
+        fields = []
+        for raw in data["fields"]:
+            constraints = raw.get("constraints", {})
+            enum = constraints.get("enum")
+            fields.append(
+                SchemaField(
+                    name=raw["name"],
+                    type=raw.get("type", "string"),
+                    required=bool(constraints.get("required", False)),
+                    minimum=constraints.get("minimum"),
+                    maximum=constraints.get("maximum"),
+                    enum=tuple(enum) if enum is not None else None,
+                    pattern=constraints.get("pattern"),
+                    portal_geo=raw.get("x-dane-gov-pl-geo"),
+                )
+            )
+        primary_key = data.get("primaryKey", ())
+        if isinstance(primary_key, str):
+            primary_key = (primary_key,)
+        return cls(fields=tuple(fields), primary_key=tuple(primary_key))
+
+    @classmethod
+    def from_file(cls, path: Union[str, Path]) -> "TableSchema":
+        with open(path, encoding="utf-8") as handle:
+            return cls.from_dict(json.load(handle))
+
+    @property
+    def column_names(self) -> List[str]:
+        return [f.name for f in self.fields]
+
+    @property
+    def required_names(self) -> List[str]:
+        return [f.name for f in self.fields if f.required]
+
+
+@dataclass(frozen=True)
+class Provider:
+    """Who publishes a source table in the portal; written into every row taken from it."""
+
+    name: str
+    resource_url: str = ""
+    updated: str = ""
+    resource_id: Optional[int] = None
+
+
+@dataclass
+class SourceReport:
+    provider: str
+    resource_id: Optional[int]
+    rows_read: int = 0
+    rows_published: int = 0
+    skipped: Dict[str, int] = field(default_factory=dict)
+    error: Optional[str] = None
+
+    def as_dict(self) -> Dict[str, Any]:
+        return {
+            "provider": self.provider,
+            "resource_id": self.resource_id,
+            "rows_read": self.rows_read,
+            "rows_published": self.rows_published,
+            "skipped": dict(self.skipped),
+            "error": self.error,
+        }
+
+
+def normalise_header(name: Any) -> str:
+    text = str(name).replace("﻿", "").strip().lower()
+    return re.sub(r"[\s\-]+", "_", text)
+
+
+def _decode(content: bytes) -> str:
+    for encoding in _CSV_ENCODINGS:
+        try:
+            return content.decode(encoding)
+        except UnicodeDecodeError:
+            continue
+    raise SourceReadError("Nie udało się odczytać kodowania pliku CSV.")
+
+
+def read_table(content: bytes, extension: Optional[str]) -> pd.DataFrame:
+    """Reads a provider's file into a DataFrame of strings (empty cells as "")."""
+    extension = (extension or "").lower().lstrip(".")
+    if extension not in SUPPORTED_EXTENSIONS:
+        raise SourceReadError(f"Nieobsługiwany format pliku: {extension or 'brak'}.")
+    try:
+        if extension == "csv":
+            text = _decode(content)
+            sample = text[:65536]
+            try:
+                delimiter = csv.Sniffer().sniff(sample, delimiters=_CSV_DELIMITERS).delimiter
+            except csv.Error:
+                delimiter = ","
+            df = pd.read_csv(io.StringIO(text), sep=delimiter, dtype=str, keep_default_na=False)
+        else:
+            df = pd.read_excel(io.BytesIO(content), dtype=str, keep_default_na=False)
+    except AggregatedListError:
+        raise
+    except Exception as exc:
+        raise SourceReadError(f"Nie udało się odczytać pliku: {exc}") from exc
+    df.columns = [normalise_header(c) for c in df.columns]
+    return df
+
+
+def check_columns(df: pd.DataFrame, schema: TableSchema) -> None:
+    missing = [name for name in schema.required_names if name not in df.columns]
+    if missing:
+        raise MissingColumnsError(missing)
+
+
+def _normalise_value(value: Any, schema_field: SchemaField) -> str:
+    if value is None or (isinstance(value, float) and pd.isna(value)):
+        return ""
+    text = str(value).strip()
+    if text.lower() in ("nan", "none", "null"):
+        return ""
+    if schema_field.type in ("number", "integer"):
+        text = text.replace(",", ".").replace(" ", "")
+    if schema_field.type == "date" and re.fullmatch(r"\d{4}-\d{2}-\d{2}[ T]00:00:00", text):
+        # A date cell read from a spreadsheet as text comes with midnight attached.
+        text = text[:10]
+    if schema_field.pattern:
+        # Spreadsheets turn codes such as TERYT "0201011" into numbers, dropping leading zeros
+        # (and sometimes adding ".0"). Restore them when the pattern is "exactly N digits".
+        match = _DIGITS_PATTERN.match(schema_field.pattern)
+        if match:
+            digits = int(match.group(1))
+            if re.fullmatch(r"\d+\.0", text):
+                text = text[:-2]
+            if text.isdigit() and len(text) < digits:
+                text = text.zfill(digits)
+    return text
+
+
+def clean_table(df: pd.DataFrame, schema: TableSchema) -> Tuple[pd.DataFrame, Dict[str, int]]:
+    """
+    Keeps the schema's columns (in its order) and the rows whose required values are present and valid.
+    Returns the cleaned table and the number of skipped rows per reason.
+    """
+    check_columns(df, schema)
+    df = df.reindex(columns=schema.column_names)
+    for schema_field in schema.fields:
+        df[schema_field.name] = df[schema_field.name].map(lambda v, f=schema_field: _normalise_value(v, f))
+
+    reasons: List[Optional[str]] = []
+    required = [f for f in schema.fields if f.required]
+    for row in df.itertuples(index=False):
+        values = dict(zip(schema.column_names, row))
+        reason = None
+        for schema_field in required:
+            value = values[schema_field.name]
+            if value == "":
+                reason = SKIP_EMPTY_REQUIRED
+                break
+            reason = schema_field.problem(value)
+            if reason:
+                break
+        reasons.append(reason)
+
+    keep = [reason is None for reason in reasons]
+    skipped = Counter(reason for reason in reasons if reason)
+    return df[keep].reset_index(drop=True), dict(skipped)
+
+
+def merge_tables(
+    parts: Iterable[Tuple[Provider, pd.DataFrame]],
+    schema: TableSchema,
+) -> Tuple[pd.DataFrame, List[SourceReport]]:
+    """
+    Cleans each provider's table and concatenates them, adding the provider columns.
+    A table that cannot be used is reported with `error` and contributes no rows.
+    """
+    columns = schema.column_names + list(PROVIDER_COLUMNS)
+    frames: List[pd.DataFrame] = []
+    reports: List[SourceReport] = []
+    seen_keys = set()
+
+    for provider, df in parts:
+        report = SourceReport(provider=provider.name, resource_id=provider.resource_id, rows_read=len(df))
+        reports.append(report)
+        try:
+            cleaned, skipped = clean_table(df, schema)
+        except MissingColumnsError as exc:
+            report.error = str(exc)
+            continue
+        report.skipped.update(skipped)
+
+        if schema.primary_key:
+            keys = [tuple(row) for row in cleaned[list(schema.primary_key)].itertuples(index=False)]
+            fresh = []
+            for key in keys:
+                fresh.append(key not in seen_keys)
+                seen_keys.add(key)
+            duplicates = len(fresh) - sum(fresh)
+            if duplicates:
+                report.skipped[SKIP_DUPLICATE_KEY] = report.skipped.get(SKIP_DUPLICATE_KEY, 0) + duplicates
+            cleaned = cleaned[fresh].reset_index(drop=True)
+
+        cleaned[PROVIDER_NAME_COLUMN] = provider.name
+        cleaned[PROVIDER_RESOURCE_COLUMN] = provider.resource_url
+        cleaned[PROVIDER_UPDATED_COLUMN] = provider.updated
+        report.rows_published = len(cleaned)
+        frames.append(cleaned)
+
+    if frames:
+        merged = pd.concat(frames, ignore_index=True)[columns]
+    else:
+        merged = pd.DataFrame(columns=columns)
+    return merged, reports
+
+
+def portal_table_schema(schema: TableSchema, missing_values: Sequence[str] = ()) -> Dict[str, Any]:
+    """
+    The summary table's schema in the form the portal stores for a resource (`Resource.tabular_data_schema`).
+
+    Without it the portal guesses column types from the data and rejects the whole summary when a guess
+    fails, e.g. house numbers "57", "41" make the column an integer and "50B" breaks it. Only required
+    columns get their schema type: their values are checked by `clean_table`, so they always cast. Every
+    other column is text, because its values pass unchecked. The map roles (`x-dane-gov-pl-geo`) set the
+    map preview, so it survives the nightly replacement of the file.
+
+    `missing_values` must equal the resource's special signs, or the portal discards this schema and
+    guesses again (mcod/resources/tasks/process_resource_file_data.py, `_resolve_tabular_data_schema`).
+    """
+    by_name = {f.name: f for f in schema.fields}
+    fields: List[Dict[str, Any]] = []
+    geo: Dict[str, Dict[str, Any]] = {}
+    for index, name in enumerate(schema.column_names + list(PROVIDER_COLUMNS)):
+        schema_field = by_name.get(name)
+        typed = schema_field is not None and schema_field.required and schema_field.type in ("number", "integer", "date")
+        entry: Dict[str, Any] = {"name": name, "type": schema_field.type if typed else "string", "format": "default"}
+        role = schema_field.portal_geo if schema_field is not None else None
+        if role:
+            entry["geo"] = role
+            geo[role] = {"col_name": name, "col_index": index}
+        fields.append(entry)
+    result: Dict[str, Any] = {"fields": fields, "missingValues": list(missing_values)}
+    if geo:
+        result["geo"] = geo
+    return result
+
+
+def to_csv_bytes(df: pd.DataFrame) -> bytes:
+    """CSV as RFC 4180: UTF-8 without BOM, comma separated, CRLF line endings, quotes only when needed."""
+    buffer = io.StringIO()
+    writer = csv.writer(buffer, delimiter=",", quotechar='"', quoting=csv.QUOTE_MINIMAL, lineterminator="\r\n")
+    writer.writerow(list(df.columns))
+    for row in df.itertuples(index=False):
+        writer.writerow(["" if value is None else value for value in row])
+    return buffer.getvalue().encode("utf-8")
+
+
+def summarise(reports: Iterable[SourceReport]) -> "OrderedDict[str, Any]":
+    """Totals for logs and the AggregatedListInfo record."""
+    reports = list(reports)
+    skipped: Counter = Counter()
+    for report in reports:
+        skipped.update(report.skipped)
+    return OrderedDict(
+        sources=len(reports),
+        sources_used=sum(1 for r in reports if r.error is None and r.rows_published > 0),
+        sources_rejected=sum(1 for r in reports if r.error is not None),
+        rows_read=sum(r.rows_read for r in reports),
+        rows_published=sum(r.rows_published for r in reports),
+        skipped=dict(skipped),
+    )
diff --git a/mcod/resources/aggregated_lists/definitions.py b/mcod/resources/aggregated_lists/definitions.py
new file mode 100644
index 0000000..cf48f6b
--- /dev/null
+++ b/mcod/resources/aggregated_lists/definitions.py
@@ -0,0 +1,102 @@
+"""
+Registry of aggregated lists ("wykazy zbiorcze").
+
+A list is defined once here. The portal then, every night (see `build_all_aggregated_lists_task`):
+
+- finds published tabular resources (CSV, XLSX, XLS) of published datasets that carry the list's
+  membership tag (e.g. `wykaz-aed`),
+- checks each against the list's standard columns (a Frictionless Table Schema in `schemas/`),
+- merges the valid rows into one CSV, with every row marked with the institution that published it,
+- publishes that CSV as the resource of a summary dataset owned by the ministry.
+
+It generalises the DGA "Wykaz chronionych danych" summary (mcod/resources/dga_utils.py), which is
+hard-wired to one list; adding a list here needs no other code. No Django imports: the owner
+institution comes from settings at run time (`service.owner_organization_pk`).
+"""
+
+from dataclasses import dataclass, field
+from functools import lru_cache
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple
+
+from mcod.resources.aggregated_lists.core import PROVIDER_COLUMNS, TableSchema
+
+SCHEMAS_DIR = Path(__file__).resolve().parent / "schemas"
+
+
+@lru_cache(maxsize=None)
+def _load_schema(path: str) -> TableSchema:
+    return TableSchema.from_file(path)
+
+
+@dataclass(frozen=True)
+class AggregatedListDefinition:
+    slug: str
+    # Reserved tag a provider adds to its dataset to put its resources on the list.
+    tag: str
+    # File name (in SCHEMAS_DIR) of the Table Schema with the list's standard columns.
+    schema_file: str
+    dataset_title: str
+    dataset_description: str
+    resource_title: str
+    resource_description: str
+    file_name_prefix: str
+    category_titles: Tuple[str, ...] = ()
+    # Tags of the summary dataset. Must not include `tag`, or the summary would feed itself.
+    dataset_tags: Tuple[str, ...] = ()
+    # None: settings.AGGREGATED_LISTS_OWNER_ORGANIZATION_PK (the ministry).
+    owner_organization_pk: Optional[int] = None
+    extra: Dict[str, str] = field(default_factory=dict)
+
+    def __post_init__(self):
+        if self.tag in self.dataset_tags:
+            raise ValueError(f"Summary dataset of list {self.slug!r} must not carry its membership tag {self.tag!r}.")
+
+    @property
+    def schema(self) -> TableSchema:
+        return _load_schema(str(SCHEMAS_DIR / self.schema_file))
+
+    @property
+    def output_columns(self) -> List[str]:
+        return self.schema.column_names + list(PROVIDER_COLUMNS)
+
+
+AED = AggregatedListDefinition(
+    slug="aed",
+    tag="wykaz-aed",
+    schema_file="aed.json",
+    dataset_title="Wykaz defibrylatorów AED – wykaz zbiorczy",
+    dataset_description=(
+        "Ogólnopolski wykaz publicznie dostępnych defibrylatorów AED, składany automatycznie każdej nocy "
+        "z zasobów, które dysponenci danych publikują w portalu dane.gov.pl. Do wykazu trafiają zasoby "
+        "(CSV, XLSX lub XLS) ze zbiorów oznaczonych tagiem „wykaz-aed”, jeśli mają kolumny wzorca danych AED. "
+        "Każdy wiersz ma kolumnę „dysponent_danych”: za poprawność, aktualność i jakość danych w danym wierszu "
+        "odpowiada wskazany w niej dysponent. Kolumny „zasob_zrodlowy” i „aktualizacja_zasobu_zrodlowego” "
+        "wskazują zasób, z którego pochodzi wiersz."
+    ),
+    resource_title="Defibrylatory AED – wykaz zbiorczy (CSV)",
+    resource_description=(
+        "Wszystkie defibrylatory AED z zasobów dysponentów oznaczonych tagiem „wykaz-aed”, w jednej tabeli "
+        "zgodnej ze wzorcem danych AED (CSV, UTF-8, separator przecinek). Wykaz jest odświeżany codziennie. "
+        "Za dane w każdym wierszu odpowiada dysponent wskazany w kolumnie „dysponent_danych”."
+    ),
+    file_name_prefix="Wykaz defibrylatorów AED – wykaz zbiorczy",
+    category_titles=("Zdrowie", "Regiony i miasta"),
+    dataset_tags=("AED", "defibrylator", "wykaz zbiorczy"),
+)
+
+REGISTRY: Dict[str, AggregatedListDefinition] = {definition.slug: definition for definition in (AED,)}
+
+
+def get_definition(slug: str) -> AggregatedListDefinition:
+    try:
+        return REGISTRY[slug]
+    except KeyError:
+        known = ", ".join(sorted(REGISTRY)) or "brak"
+        raise KeyError(f"Nieznany wykaz zbiorczy: {slug!r}. Dostępne: {known}.") from None
+
+
+def definitions_for_tags(tag_names) -> List[AggregatedListDefinition]:
+    """Lists a dataset joins through its tags (compared case-insensitively)."""
+    names = {str(name).strip().lower() for name in tag_names}
+    return [definition for definition in REGISTRY.values() if definition.tag.lower() in names]
